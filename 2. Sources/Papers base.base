filters:
  and:
    - file.inFolder("Notes/3. Art. Notes")
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Notes/3. Art. Notes")
    order:
      - Tittle
      - Journal
      - Author
    sort:
      - property: Author
        direction: ASC
      - property: file.name
        direction: ASC
